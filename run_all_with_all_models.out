.CITY2+END+AS+CITY2%2C+CASE+WHEN+sm.EQUNR+IS+NOT+NULL+THEN+sm.EMAIL+ELSE+nm.EMAIL+END+AS+EMAIL+FROM+J09B_temp+jt+LEFT+JOIN+eablg+ON+jt.ANLAGE+%3D+eablg.Installation+LEFT+JOIN+net_master+nm+ON+jt.EQUNR+%3D+nm.EQUNR+LEFT+JOIN+sales_master+sm+ON+jt.EQUNR+%3D+sm.EQUNR%3B+UPDATE+J09B_final+SET+NET_TITLE+%3D+NULL%2C+NET_FORENAME+%3D+NULL%2C+NET_SURNAME+%3D+NULL%2C+NET_STREET+%3D+NULL%2C+NET_STREETNO+%3D+NULL%2C+NET_POST_CODE1+%3D+NULL%2C+NET_CITY1+%3D+NULL%2C+NET_CITY2+%3D+NULL%2C+NET_EMAIL+%3D+NULL+WHERE+SALES_TITLE+IS+NOT+NULL+OR+SALES_FORENAME+IS+NOT+NULL+OR+SALES_SURNAME+IS+NOT+NULL+OR+SALES_STREET+IS+NOT+NULL+OR+SALES_STREETNO+IS+NOT+NULL+OR+SALES_POST_CODE1+IS+NOT+NULL+OR+SALES_CITY1+IS+NOT+NULL+OR+SALES_CITY2+IS+NOT+NULL+OR+SALES_EMAIL+IS+NOT+NULL%3B+UPDATE+J09B_final+SET+SALES_TITLE+%3D+NULL%2C+SALES_FORENAME+%3D+NULL%2C+SALES_SURNAME+%3D+NULL%2C+SALES_STREET+%3D+NULL%2C+SALES_STREETNO+%3D+NULL%2C+SALES_POST_CODE1+%3D+NULL%2C+SALES_CITY1+%3D+NULL%2C+SALES_CITY2+%3D+NULL%2C+SALES_EMAIL+%3D+NULL+WHERE+NOT+%28SALES_TITLE+IS+NOT+NULL+OR+SALES_FORENAME+IS+NOT+NULL+OR+SALES_SURNAME+IS+NOT+NULL+OR+SALES_STREET+IS+NOT+NULL+OR+SALES_STREETNO+IS+NOT+NULL+OR+SALES_POST_CODE1+IS+NOT+NULL+OR+SALES_CITY1+IS+NOT+NULL+OR+SALES_CITY2+IS+NOT+NULL+OR+SALES_EMAIL+IS+NOT+NULL%29%3B+UPDATE+J09B_final+SET+ENTSCHEIDUNG+%3D+%27MANDATORY_READING%27+WHERE+EQUNR+IN+%28SELECT+EQUNR+FROM+eabl+WHERE+ISTABLART_TXT+%3D+%27Maschinelle+Sch%C3%A4tzung+-+SAP%27+AND+substr%28%22Record+created+on%22%2C1%2C4%29+%3D+%272024%27+INTERSECT+SELECT+EQUNR+FROM+eabl+WHERE+ISTABLART_TXT+%3D+%27Maschinelle+Sch%C3%A4tzung+-+SAP%27+AND+substr%28%22Record+created+on%22%2C1%2C4%29+%3D+%272023%27%29%3B+UPDATE+J09B_final+SET+ENTSCHEIDUNG+%3D+%27DIRECT_MAIL%27+WHERE+EQUNR+IN+%28SELECT+EQUNR+FROM+eabl+WHERE+ISTABLART_TXT+%3D+%27Ablesung+durch+Kunden+-+SAP%27+AND+substr%28%22Record+created+on%22%2C1%2C4%29+%3D+%272024%27+INTERSECT+SELECT+EQUNR+FROM+eabl+WHERE+ISTABLART_TXT+%3D+%27Ablesung+durch+Kunden+-+SAP%27+AND+substr%